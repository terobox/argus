# Vite dev server only: where /api (including the SSE stream) is proxied.
# Copy this file to .env.local to change it; .env.local is gitignored.
#
# No VITE_ prefix on purpose: the proxy runs in Node, and the browser must keep
# calling same-origin /api so the session cookie and CSRF checks work.
ARGUS_SERVER_URL=http://127.0.0.1:8095
